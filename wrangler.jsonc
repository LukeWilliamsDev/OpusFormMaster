// Cloudflare deployment retry trigger
{
  "compatibility_date": "2026-09-28",
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
  },
  "build": {
    "command": "node scripts/validate-worker-build-env.mjs && npm run build",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "name": "lovable-opus-form",
}
